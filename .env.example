PORT=8787
SYNAU_DEMO_MODE=false
SYNAU_DB_PATH=.data/synau.db
SYNAU_STORAGE=sqlite
SYNAU_PROVIDER_ID=sumopod
SYNAU_PROVIDER_NAME=Sumopod
SYNAU_OPENAI_BASE_URL=https://ai.sumopod.com/v1
SYNAU_OPENAI_MODEL=deepseek-v4-flash
SYNAU_OPENAI_API_KEY=
SYNAU_PROVIDER_TIMEOUT_MS=120000

# Platform credits. Generator pricing is fixed at 1 credit per successful roadmap,
# lesson, or quiz generator. Token telemetry does not change the user charge.
SYNAU_DEMO_CREDITS=10000

# Midtrans is sandbox by default. Keep all secret keys out of source control.
SYNAU_MIDTRANS_MERCHANT_ID=
SYNAU_MIDTRANS_CLIENT_KEY=
SYNAU_MIDTRANS_SERVER_KEY=
SYNAU_MIDTRANS_PRODUCTION=false

# Passwordless authentication. Use console only for local development; it
# prints the code to the server terminal. Production must use SMTP.
SYNAU_AUTH_CODE_SECRET=replace-with-a-long-random-secret
SYNAU_AUTH_CODE_TTL_MINUTES=10
SYNAU_AUTH_CODE_RESEND_COOLDOWN_SECONDS=45
SYNAU_EMAIL_MODE=smtp
SYNAU_EMAIL_FROM=Synau <no-reply@example.com>
SYNAU_SMTP_HOST=smtp.example.com
SYNAU_SMTP_PORT=587
SYNAU_SMTP_SECURE=false
SYNAU_SMTP_USER=
SYNAU_SMTP_PASSWORD=

# Supabase project configuration. The VITE_* aliases are used by this Vite app;
# NEXT_PUBLIC_* aliases are kept for Supabase tooling and future Next.js clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required only when this project's Data API accepts secret keys.
SUPABASE_SECRET_KEY=
